# Copy this file to .env for local development. Never commit .env.
# Replace every placeholder with credentials for your own accounts/services.

# Garmin Personal API
GARMIN_PERSONAL_API_KEY=replace-with-your-garmin-personal-api-key

# MyFitnessPal
MFP_COOKIE=replace-with-your-mfp-session-cookie
MFP_USERNAME=your-mfp-username
MFP_MCP_DATA_DIR=/tmp/runfuel-mfp

# RunFuel OAuth
RUNFUEL_BASE_URL=https://your-runfuel-domain.example.com
RUNFUEL_OAUTH_PASSWORD=replace-with-a-long-unique-random-password

# Optional dedicated encryption-key override for the mobile Token Manager.
# Normally omitted: RunFuel derives a stable key from RUNFUEL_OAUTH_PASSWORD
# and UPSTASH_REDIS_REST_TOKEN. Keep those two server secrets stable while
# managed credentials are stored. Never commit or share a dedicated key.
# RUNFUEL_SECRET_ENCRYPTION_KEY=

# Upstash Redis REST credentials for OAuth state, token records, and encrypted credentials
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-redis-token

# Optional legacy static bearer token. Prefer OAuth for Claude connectors.
# RUNFUEL_ACCESS_TOKEN=replace-with-a-long-random-secret
